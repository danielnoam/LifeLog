<?xml version="1.0" encoding="utf-8"?>
<!-- A day in the Calendar widget's month: a line at its start, its number
     (on a filled circle for today) and as many chips as its height holds. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_cell"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/cal_line"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/widget_line" />

    <LinearLayout
        android:id="@+id/cal_chips"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="1dp"
        android:paddingEnd="1dp">

        <TextView
            android:id="@+id/cal_num"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
