<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- A clear fill, said outright: with no <solid>, a tinted GradientDrawable
         fills its inside with the tint too, and the chip hides its own name. -->
    <solid android:color="#00FFFFFF" />
    <stroke android:width="1dp" android:color="#FFFFFFFF" android:dashWidth="3dp" android:dashGap="2dp" />
    <corners android:radius="3dp" />
</shape>
