<?xml version="1.0" encoding="utf-8"?>
<!-- The Calendar widget's marks (Nov 2026), as the Home calendar's: a bar is
     an event, a ring a task, a dashed square a release, a dot something
     finished. White; the row tints each to its colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="2dp" />
    <size android:width="4dp" android:height="16dp" />
</shape>
