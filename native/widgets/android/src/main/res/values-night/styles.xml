<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LifeLogWidgetSettings" parent="@android:style/Theme.Material.Dialog.MinWidth">
        <item name="android:colorAccent">@color/widget_accent</item>
    </style>

    <!-- The quick-add window (QuickAddActivity): a sheet at the foot of the
         screen, over a dimmed home screen. -->
    <style name="LifeLogQuickAdd" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:colorAccent">@color/widget_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
    </style>
</resources>
