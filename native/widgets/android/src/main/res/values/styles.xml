<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LifeLogWidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The note widgets' settings: a plain dialog over the home screen. -->
    <style name="LifeLogWidgetSettings" parent="@android:style/Theme.Material.Light.Dialog.MinWidth">
        <item name="android:colorAccent">@color/widget_accent</item>
    </style>
</resources>
