<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Habit reminders: asked for when the first one is set, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarms don't survive a reboot; this puts the next reminder back. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The app lock's fingerprint / face unlock (Biometrics). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application>
        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.HabitsWidget"
            android:exported="false"
            android:label="@string/widget_habits_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habits_info" />
        </receiver>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.TodosWidget"
            android:exported="false"
            android:label="@string/widget_todos_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_todos_info" />
        </receiver>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.QuickAddWidget"
            android:exported="false"
            android:label="@string/widget_quickadd_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quickadd_info" />
        </receiver>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.SpendWidget"
            android:exported="false"
            android:label="@string/widget_spend_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spend_info" />
        </receiver>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.NoteWidget"
            android:exported="false"
            android:label="@string/widget_note_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_note_info" />
        </receiver>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.RandomNoteWidget"
            android:exported="false"
            android:label="@string/widget_randomnote_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_randomnote_info" />
        </receiver>

        <!-- The widgets' settings. Exported because the launcher starts
             them when a widget is placed; taskAffinity="" keeps them out of
             the app's own task, so finishing one doesn't bring LifeLog up. -->
        <activity
            android:name="io.github.danielnoam.lifelog.widgets.NotePickActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/LifeLogWidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.danielnoam.lifelog.widgets.TodosSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/LifeLogWidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="io.github.danielnoam.lifelog.widgets.RandomNoteSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/LifeLogWidgetSettings">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="io.github.danielnoam.lifelog.widgets.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name="io.github.danielnoam.lifelog.widgets.ListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
