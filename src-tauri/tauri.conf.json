{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeLog",
  "identifier": "io.github.danielnoam.lifelog",
  "version": "0.0.0",
  "build": {
    "frontendDist": "../www-desktop",
    "beforeBuildCommand": "node tools/build-www.js www-desktop --desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LifeLog",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#11141a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Your log of what you did, what's next and what it cost.",
    "publisher": "Daniel Noam",
    "homepage": "https://github.com/danielnoam/LifeLog",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/danielnoam/LifeLog/releases/latest/download/latest.json"],
      "pubkey": "",
      "windows": { "installMode": "passive" }
    }
  }
}
